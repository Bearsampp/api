                            <row>
<entry>string</entry><entry>$executable</entry><entry>
<para><link linkend="_class_path">Path</link> to the executable (will be escapeshellarg&apos;d). </para>
</entry>
                            </row>
                            <row>
<entry>array</entry><entry>$args</entry><entry>
<para>Arguments, each will be escapeshellarg&apos;d. </para>
</entry>
                            </row>
                            <row>
<entry>callable</entry><entry>$lineCallback</entry><entry>
